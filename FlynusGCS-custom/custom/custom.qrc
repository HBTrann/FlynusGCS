<RCC>
    <!-- Files under /Custom/... replace the stock QGC file at the same path
         (see CustomOverrideInterceptor in src/CustomPlugin.cc). -->
    <qresource prefix="/Custom/res">
        <file alias="QGCLogoFull.svg">res/Images/FlynusLogoTile.svg</file>
        <file alias="QGCLogoWhite.svg">res/Images/FlynusLogoWhite.svg</file>
        <file alias="QGCLogoWhite">res/Images/FlynusLogoWhite.svg</file>
        <file alias="qgroundcontrol.ico">res/icons/flynus_gcs.ico</file>
    </qresource>
    <!-- QML overrides: centered compass + telemetry, left status panel with flight-time ring, mode-only top bar -->
    <qresource prefix="/Custom/qml/QGroundControl/FlyView">
        <file alias="FlyViewBottomRightRowLayout.qml">res/qml/FlyView/FlyViewBottomRightRowLayout.qml</file>
        <file alias="FlyViewWidgetLayer.qml">res/qml/FlyView/FlyViewWidgetLayer.qml</file>
        <file alias="FlyViewMap.qml">res/qml/FlyView/FlyViewMap.qml</file>
        <file alias="FlyViewToolStripActionList.qml">res/qml/FlyView/FlyViewToolStripActionList.qml</file>
    </qresource>
    <qresource prefix="/Custom/qml/QGroundControl/Toolbar">
        <file alias="FlyViewToolBar.qml">res/qml/Toolbar/FlyViewToolBar.qml</file>
        <file alias="SelectViewDropdown.qml">res/qml/Toolbar/SelectViewDropdown.qml</file>
    </qresource>
    <qresource prefix="/Custom/qml/QGroundControl/Controls">
        <file alias="QGCToolBarButton.qml">res/qml/Controls/QGCToolBarButton.qml</file>
        <file alias="SettingsButton.qml">res/qml/Controls/SettingsButton.qml</file>
        <file alias="ParameterEditor.qml">res/qml/Controls/ParameterEditor.qml</file>
    </qresource>
    <!-- Configure > Radio: merged page (pairing, remote channels, stock calibration, check) -->
    <qresource prefix="/Custom/qml/QGroundControl/AutoPilotPlugins/Common">
        <file alias="RadioComponent.qml">res/qml/AutoPilotPlugins/RadioComponent.qml</file>
    </qresource>
    <!-- Map vehicle icon: Flynus quad instead of the QGC arrow -->
    <qresource prefix="/Custom/qmlimages">
        <file alias="vehicleArrowOpaque.svg">res/Images/FlynusDrone.svg</file>
    </qresource>
    <!-- Extra brand assets available to QML as qrc:/flynus/... -->
    <qresource prefix="/flynus">
        <file alias="FlynusWordmark.svg">res/Images/FlynusWordmark.svg</file>
        <file alias="FlynusWordmarkWhite.svg">res/Images/FlynusWordmarkWhite.svg</file>
        <file alias="FlynusLogo.svg">res/Images/FlynusLogoFull.svg</file>
        <file alias="FlynusWordmarkTile.svg">res/Images/FlynusWordmarkTile.svg</file>
        <file alias="icons/battery.svg">res/icons/ui/battery.svg</file>
        <file alias="icons/gps.svg">res/icons/ui/gps.svg</file>
        <file alias="icons/rc.svg">res/icons/ui/rc.svg</file>
        <file alias="icons/telemetry.svg">res/icons/ui/telemetry.svg</file>
        <file alias="icons/takeoff.svg">res/icons/ui/takeoff.svg</file>
        <file alias="icons/rth.svg">res/icons/ui/rth.svg</file>
        <file alias="icons/land.svg">res/icons/ui/land.svg</file>
        <file alias="icons/pause.svg">res/icons/ui/pause.svg</file>
        <file alias="icons/plan.svg">res/icons/ui/plan.svg</file>
        <file alias="icons/setup.svg">res/icons/ui/setup.svg</file>
        <file alias="icons/analyze.svg">res/icons/ui/analyze.svg</file>
        <file alias="icons/settings.svg">res/icons/ui/settings.svg</file>
        <file alias="icons/power.svg">res/icons/ui/power.svg</file>
        <file alias="icons/star.svg">res/icons/ui/star.svg</file>
        <file alias="icons/star-filled.svg">res/icons/ui/star-filled.svg</file>
        <file alias="icons/search.svg">res/icons/ui/search.svg</file>
        <file alias="icons/settings/general.svg">res/icons/ui/settings/general.svg</file>
        <file alias="icons/settings/fly.svg">res/icons/ui/settings/fly.svg</file>
        <file alias="icons/settings/3d.svg">res/icons/ui/settings/3d.svg</file>
        <file alias="icons/settings/plan.svg">res/icons/ui/settings/plan.svg</file>
        <file alias="icons/settings/adsb.svg">res/icons/ui/settings/adsb.svg</file>
        <file alias="icons/settings/links.svg">res/icons/ui/settings/links.svg</file>
        <file alias="icons/settings/logging.svg">res/icons/ui/settings/logging.svg</file>
        <file alias="icons/settings/log-viewer.svg">res/icons/ui/settings/log-viewer.svg</file>
        <file alias="icons/settings/maps.svg">res/icons/ui/settings/maps.svg</file>
        <file alias="icons/settings/rtk.svg">res/icons/ui/settings/rtk.svg</file>
        <file alias="icons/settings/transfer.svg">res/icons/ui/settings/transfer.svg</file>
        <file alias="icons/settings/remote-id.svg">res/icons/ui/settings/remote-id.svg</file>
        <file alias="icons/settings/telemetry.svg">res/icons/ui/settings/telemetry.svg</file>
        <file alias="icons/settings/video.svg">res/icons/ui/settings/video.svg</file>
        <file alias="icons/settings/help.svg">res/icons/ui/settings/help.svg</file>
        <file alias="icons/settings/chevron.svg">res/icons/ui/settings/chevron.svg</file>
        <file alias="fonts/FlynusUI-Regular.ttf">res/fonts/FlynusUI-Regular.ttf</file>
        <file alias="fonts/FlynusUI-SemiBold.ttf">res/fonts/FlynusUI-SemiBold.ttf</file>
        <file alias="fonts/FlynusUI-Bold.ttf">res/fonts/FlynusUI-Bold.ttf</file>
    </qresource>
</RCC>
